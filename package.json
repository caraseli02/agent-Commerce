{
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/build-with-tailwind-guard.mjs",
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/nuxt/bin/nuxt.mjs dev",
    "generate": "nuxt generate",
    "preview": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/nuxt/bin/nuxt.mjs preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --ignore-pattern 'node_modules' --ignore-pattern '.nuxt' --ignore-pattern '.output' --ignore-pattern 'dist' --ignore-pattern '.agents/skills/impeccable/**'",
    "pretty": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/db-migrate.mjs",
    "test": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/with-test-database.mjs pnpm exec vitest run",
    "test:coverage": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/with-test-database.mjs pnpm exec vitest run --coverage",
    "test:performance": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/with-test-database.mjs pnpm exec playwright test --config=playwright.performance.config.ts",
    "deps:outdated": "pnpm --ignore-workspace outdated",
    "deps:audit": "pnpm --ignore-workspace audit --prod",
    "clean-state": "node scripts/check-clean-state.mjs",
    "test:e2e": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/with-test-database.mjs pnpm exec playwright test",
    "test:parity": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/with-test-database.mjs pnpm exec playwright test --config=playwright.parity.config.ts",
    "test:visual": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/with-test-database.mjs pnpm exec playwright test --config=playwright.visual.config.ts",
    "test:visual:update": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/with-test-database.mjs pnpm exec playwright test --config=playwright.visual.config.ts --update-snapshots",
    "verify": "node scripts/verify.mjs",
    "verify:full": "node scripts/verify.mjs --full",
    "verify:handoff": "node scripts/verify.mjs --handoff",
    "prepare": "husky",
    "smoke": "node scripts/smoke.mjs"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,vue,json,md,yml,yaml,css,scss,html}": [
      "pnpm exec prettier --write --ignore-unknown"
    ]
  },
  "pnpm": {
    "overrides": {
      "@vue/reactivity": "3.5.41",
      "@vue/runtime-core": "3.5.41",
      "@vue/runtime-dom": "3.5.41",
      "@vue/server-renderer": "3.5.41",
      "@vue/shared": "3.5.41",
      "vue": "3.5.41"
    }
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/leaflet": "^1.3.2",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/compiler-dom": "^3.5.41",
    "eslint": "^10.8.1",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "nuxt": "4.5.2",
    "nuxt-svgo": "^5.3.0",
    "nuxt-viewport": "^2.6.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "shadcn-nuxt": "^2.8.2",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "uuid": "^11.1.0",
    "vite-plugin-eslint2": "^5.0.5",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.9"
  },
  "dependencies": {
    "@lucide/vue": "^1.31.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "^2.1.0",
    "@pinia/nuxt": "^1.0.2",
    "@radix-icons/vue": "^1.0.0",
    "@stripe/stripe-js": "^10.0.0",
    "@tanstack/vue-table": "^8.21.3",
    "@tanstack/vue-virtual": "^3.13.18",
    "@vee-validate/zod": "^4.15.1",
    "@vercel/functions": "^3.9.5",
    "@vuemod/vue-touch": "^0.0.22",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "@zoom-image/core": "^0.42.0",
    "@zoom-image/vue": "^0.2.32",
    "apexcharts": "5.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-vue": "^8.6.0",
    "h3": "^1.15.11",
    "lodash-es": "^4.18.1",
    "nuxt-swiper": "^2.0.2",
    "pg": "^8.23.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "radix-vue": "^1.9.17",
    "stripe": "22.6.2",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "tiny-emitter": "^2.1.0",
    "v-calendar": "^3.1.2",
    "vee-validate": "^4.15.1",
    "vue3-apexcharts": "^1.11.1",
    "vuejs-paginate-next": "^1.0.2",
    "zod": "^3.25.76"
  }
}
