{
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --ignore-pattern 'node_modules' --ignore-pattern '.nuxt' --ignore-pattern '.output' --ignore-pattern 'dist'",
    "pretty": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean-state": "node scripts/check-clean-state.mjs",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify.mjs",
    "verify:full": "node scripts/verify.mjs --full",
    "verify:handoff": "node scripts/verify.mjs --handoff",
    "prepare": "husky",
    "smoke": "node scripts/smoke.mjs"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,vue,json,md,yml,yaml,css,scss,html}": [
      "pnpm exec prettier --write --ignore-unknown"
    ]
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.7.6",
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/leaflet": "^1.3.2",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/compiler-dom": "^3.5.41",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "nuxt": "^3.21.1",
    "nuxt-lodash": "^2.5.3",
    "nuxt-svgo": "^3.7.0",
    "nuxt-viewport": "^2.3.1",
    "postcss": "^8.5.26",
    "prettier": "^2.8.8",
    "sass": "^1.102.0",
    "shadcn-nuxt": "^2.8.1",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "uuid": "^11.1.0",
    "vite-plugin-eslint2": "^5.0.5",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.5"
  },
  "dependencies": {
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "^2.0.0",
    "@pinia/nuxt": "^0.5.5",
    "@radix-icons/vue": "^1.0.0",
    "@tanstack/vue-table": "^8.21.3",
    "@tanstack/vue-virtual": "^3.13.18",
    "@vee-validate/zod": "^4.15.1",
    "@vuemod/vue-touch": "^0.0.22",
    "@vueuse/core": "^10.11.1",
    "@vueuse/nuxt": "^10.11.1",
    "@zoom-image/core": "^0.42.0",
    "@zoom-image/vue": "^0.2.32",
    "apexcharts": "^3.54.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^2.30.0",
    "embla-carousel-vue": "^8.6.0",
    "firebase": "^9.23.0",
    "lucide-vue-next": "^0.323.0",
    "nuxt-swiper": "^0.1.9",
    "nuxt-vuefire": "^0.1.6",
    "pinia": "^2.3.1",
    "pinia-plugin-persistedstate": "^4.1.3",
    "radix-vue": "^1.9.17",
    "tailwind-merge": "^2.6.1",
    "tiny-emitter": "^2.1.0",
    "v-calendar": "^3.1.2",
    "vee-validate": "^4.15.1",
    "vue3-apexcharts": "^1.7.0",
    "vuejs-paginate-next": "^1.0.2",
    "zod": "^3.25.76"
  }
}
