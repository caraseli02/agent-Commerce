{
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/build-with-tailwind-guard.mjs",
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/nuxt/bin/nuxt.mjs dev",
    "generate": "nuxt generate",
    "preview": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/nuxt/bin/nuxt.mjs preview",
    "pr:screenshots": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/with-test-database.mjs node scripts/pr-screenshots.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --pass-on-unpruned-suppressions --ignore-pattern 'node_modules' --ignore-pattern '.nuxt' --ignore-pattern '.output' --ignore-pattern 'dist' --ignore-pattern '.agents/skills/impeccable/**'",
    "lint:design": "DESIGN_LINT_AUDIT=1 eslint app --pass-on-unpruned-suppressions",
    "pretty": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/db-migrate.mjs",
    "test": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/with-test-database.mjs pnpm exec vitest run",
    "test:coverage": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/with-test-database.mjs pnpm exec vitest run --coverage",
    "test:performance": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/with-test-database.mjs pnpm exec playwright test --config=playwright.performance.config.ts",
    "deps:outdated": "pnpm --ignore-workspace outdated",
    "deps:audit": "pnpm --ignore-workspace audit --prod",
    "clean-state": "node scripts/check-clean-state.mjs",
    "test:e2e": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/with-test-database.mjs pnpm exec playwright test",
    "test:parity": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/with-test-database.mjs pnpm exec playwright test --config=playwright.parity.config.ts",
    "test:visual": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/with-test-database.mjs pnpm exec playwright test --config=playwright.visual.config.ts",
    "test:visual:update": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/with-test-database.mjs pnpm exec playwright test --config=playwright.visual.config.ts --update-snapshots",
    "verify": "node scripts/verify.mjs",
    "verify:full": "node scripts/verify.mjs --full",
    "verify:handoff": "node scripts/verify.mjs --handoff",
    "prepare": "husky",
    "smoke": "node scripts/smoke.mjs",
    "inventory:bootstrap": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/inventory-bootstrap.mjs"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,vue,json,md,yml,yaml,css,scss,html}": [
      "pnpm exec prettier --write --ignore-unknown"
    ]
  },
  "pnpm": {
    "overrides": {
      "@vue/compiler-core": "3.5.44",
      "@vue/compiler-dom": "3.5.44",
      "@vue/compiler-sfc": "3.5.44",
      "@vue/compiler-ssr": "3.5.44",
      "@vue/reactivity": "3.5.44",
      "@vue/runtime-core": "3.5.44",
      "@vue/runtime-dom": "3.5.44",
      "@vue/server-renderer": "3.5.44",
      "@vue/shared": "3.5.44",
      "vue": "3.5.44",
      "@vercel/cli-config>zod": "^4.6.7"
    }
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/leaflet": "^1.3.3",
    "@playwright/test": "^1.64.1",
    "@shadcn/lint": "0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/compiler-dom": "^3.5.44",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nuxt": "4.5.2",
    "nuxt-svgo": "^5.3.0",
    "nuxt-viewport": "^2.6.1",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "shadcn-nuxt": "^2.8.2",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "uuid": "^11.1.1",
    "vite-plugin-eslint2": "^5.3.0",
    "vitest": "5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "@lucide/vue": "^1.61.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "^2.2.0",
    "@pinia/nuxt": "^1.0.3",
    "@radix-icons/vue": "^1.0.0",
    "@stripe/stripe-js": "^10.1.0",
    "@tanstack/vue-table": "^8.21.3",
    "@tanstack/vue-virtual": "^3.13.48",
    "@vercel/functions": "^3.10.3",
    "@vuemod/vue-touch": "^0.0.22",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "@zoom-image/core": "^0.42.0",
    "@zoom-image/vue": "^0.2.34",
    "apexcharts": "5.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-vue": "^8.6.0",
    "h3": "^1.15.11",
    "lodash-es": "^4.18.1",
    "nuxt-swiper": "^2.0.2",
    "pg": "^8.23.1",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "radix-vue": "^1.9.17",
    "stripe": "22.6.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "v-calendar": "^3.1.2",
    "vee-validate": "^4.15.1",
    "vue3-apexcharts": "^1.11.3",
    "vuejs-paginate-next": "^1.0.2",
    "zod": "^4.6.7"
  }
}
