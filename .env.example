# Components Marketplace local environment template
# Copy to .env before running the app.
# Mock mode is the recommended setup for portfolio demos.

# Demo / portfolio mode
NUXT_PUBLIC_MOCK_MODE=true

# Base API URL
# - Mock mode: leave as /api to use Nitro mock endpoints bundled in this repo
# - Real backend mode: replace with your backend base URL
NUXT_PUBLIC_BASE_URL_API=/api

# Checkout persistence
# PostgreSQL is required for local development, tests, preview, and production.
# Apply the explicit checkout schema before running the app: pnpm db:migrate
# DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full
# Optional for the test-schema lifecycle only. Neon users can provide its direct
# connection string so create/drop-schema administration avoids the pooler.
# DATABASE_URL_UNPOOLED=postgresql://user:password@direct-host/database?sslmode=verify-full

# Optional in mock mode. Required only if you want live Firebase-backed auth/storage.

# Optional in mock mode. Only needed if a live Stripe checkout is restored.
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
